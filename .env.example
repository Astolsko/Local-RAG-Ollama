# Copy to .env and edit. Every value below is optional -- the defaults shown are
# what the app uses if the variable is unset. Environment variables take
# precedence over data/settings.json.

# --- Services ---------------------------------------------------------------
OLLAMA_BASE=http://localhost:11434
REDIS_URL=redis://127.0.0.1:6379/0?protocol=2

# --- Models -----------------------------------------------------------------
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:0.5b

# auto|small|medium|large. auto picks by total RAM:
#   <10 GB -> small, 10-20 GB -> medium, >20 GB -> large
# A tier model that is not pulled falls back to LLM_MODEL with a logged warning.
MODEL_TIER=auto

# Per-role models. Leave empty to use the tier's choice.
REWRITE_MODEL=
EXTRACT_MODEL=

# Keeps models resident in Ollama between requests instead of reloading them.
OLLAMA_KEEP_ALIVE=10m

# --- Retrieval --------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=20
RERANK_ENABLED=true

# flashrank|cross-encoder|off. flashrank is a small ONNX cross-encoder (~22 ms for a
# candidate batch vs ~1.2 s for the sentence-transformers model) and is the default.
# Its model is downloaded once into data/flashrank on first use.
RERANKER=flashrank
FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2
# Only used when RERANKER=cross-encoder
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=8

# Skip reranking when the best dense hit is already this similar (1 - cosine distance).
# Set to 1.0 to always rerank.
RERANK_SKIP_THRESHOLD=0.85

# Fused candidates handed to the reranker. Quality-affecting -- check recall@5 if lowered.
RRF_TOP_N=12

ENABLE_QUERY_REWRITE=true
QUERY_REWRITE_TIMEOUT_MS=2000

# --- Caching and limits -----------------------------------------------------
SESSION_TTL=86400
PROMPT_CACHE_TTL=3600
CACHE_SIMILARITY_THRESHOLD=0.85
RATE_LIMIT_PER_MINUTE=60

# --- Eval harness only ------------------------------------------------------
# Points the whole app at an isolated data directory. eval/run_eval.py sets this
# to eval/.data so a run never touches your real documents.
# RAG_DATA_DIR=
# Judge model for eval/run_eval.py. Should be stronger than the model under test.
# EVAL_JUDGE_MODEL=llama3.2:latest
